{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQL Tool",
  "version": "0.1.5",
  "identifier": "dev.sqltool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SQL Tool",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "SQL client for MySQL and MariaDB",
    "longDescription": "A free, open-source desktop SQL client for MySQL and MariaDB.",
    "license": "Apache-2.0",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
